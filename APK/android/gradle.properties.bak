org.gradle.jvmargs=-Xmx8G -XX:MaxMetaspaceSize=4G -XX:ReservedCodeCacheSize=512m -XX:+HeapDumpOnOutOfMemoryError
android.useAndroidX=true
# This newDsl flag was added by the Flutter template
android.newDsl=false
# This builtInKotlin flag was added by the Flutter template
android.builtInKotlin=false

# Two release builds in a row died with "Could not close incremental caches" in a
# different plugin module each time — the signature of an on-access scanner holding
# Kotlin's cache .tab files. Incremental caches buy nothing on a clean CI-style
# build, so they are switched off, and compilation runs inside the Gradle daemon
# instead of a separate Kotlin daemon so there is one fewer process holding locks.
kotlin.incremental=false
kotlin.compiler.execution.strategy=in-process
