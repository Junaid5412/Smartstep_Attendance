<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon, matching the Play Store icon: the white pin, clock and tick
     on the icon blue. Generated from Attendance/playstore_icon.jpg. The monochrome layer
     is what Android 13+ tints for themed icons. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
