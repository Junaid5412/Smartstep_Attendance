<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Attendance data (positions, photos, tokens) must never travel in the clear,
         so cleartext is off everywhere. The single exception below is localhost, so
         the app can be pointed at a developer's XAMPP over adb reverse during
         testing without weakening the production posture. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
    </domain-config>
</network-security-config>
