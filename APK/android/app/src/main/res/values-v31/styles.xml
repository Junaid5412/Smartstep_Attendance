<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ uses the platform SplashScreen API, which ignores
         windowBackground and wants these attributes instead. Without this the
         launch would show the system default (the app icon on a white field)
         rather than the brand splash. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <!-- The launcher icon's own blue and glyph, so the app opens on the same mark
             the Play Store and home screen show. -->
        <item name="android:windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
